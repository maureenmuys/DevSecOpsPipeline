pipeline {
    agent any

    stages {
        stage('Code ophalen') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/maureenmuys/DevSecOpsPipeline'
            }
        }

        stage('Deploy naar staging') {
            steps {
                sh '''
                    oc project maureenmuys-dev
                    if oc get deployment poc-app 2>/dev/null; then
                        oc set image deployment/poc-app poc-app=quay.io/maureenmuys/poc-app:latest
                        echo "Deployment bijgewerkt"
                    else
                        echo "INFO: poc-app bestaat nog niet"
                        echo "POC OK: Jenkins correct getriggerd door GitHub Actions"
                    fi
                '''
            }
        }

        stage('Goedkeuring productie') {
            steps {
                input message: "Deploy naar productie?", ok: "Goedkeuren"
            }
        }

        stage('Deploy naar productie') {
            steps {
                echo "Deploying naar productie..."
            }
        }
    }

    post {
        success { echo "✓ Pipeline succesvol" }
        failure  { echo "✗ Pipeline mislukt" }
    }
}
